# Elegancia Home — environment
#
# Copy to `.env` (local) or configure these values in Vercel.
# NEVER commit filled secrets.
# A `VITE_` prefix means the value is browser-visible. Carrier tokens never use it.

# -----------------------------------------------------------------------------
# Supabase — client (browser-visible)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
VITE_SITE_URL="https://your-shop.example"
VITE_DEMO_MODE=""

# -----------------------------------------------------------------------------
# Packers / EcoTrack delivery (SERVER ONLY)
# -----------------------------------------------------------------------------
# Get the API token from the Packers/EcoTrack merchant account.
# Add it directly in Vercel. Never paste a real token into source code or chat.
PACKERS_API_TOKEN=""
PACKERS_BASE_URL="https://packers.ecotrack.dz/"

# -----------------------------------------------------------------------------
# Legacy Guepex/Yalidine connector kept for upstream compatibility
# -----------------------------------------------------------------------------
GUEPEX_API_ID=""
GUEPEX_API_TOKEN=""
GUEPEX_BASE_URL="https://api.guepex.app/v1/"
GUEPEX_WEBHOOK_SECRET=""

# -----------------------------------------------------------------------------
# Optional: card payments (cash on delivery works without this)
# -----------------------------------------------------------------------------
CHARGILY_API_KEY=""

# -----------------------------------------------------------------------------
# End-to-end tests only
# -----------------------------------------------------------------------------
E2E_ADMIN_EMAIL=""
E2E_ADMIN_PASSWORD=""

# SERVER ONLY. Leave unset until exact Packers statuses are verified on real responses.
# JSON array of {raw, target: delivered|refused|returned, physicalReturnReceived?: true}.
# returned requires physicalReturnReceived=true; see docs/PACKERS_STATUS_SYNC.md.
PACKERS_VERIFIED_STATUS_RULES=[]

# Telegram notifications (SERVER ONLY; already configured in Vercel for Elegancia).
# Never prefix these names with VITE_ or commit filled values.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ERPNext finance (SERVER ONLY). No VITE_ prefix; disabled until configured/tested.
ERPNEXT_ENABLED=false
ERPNEXT_URL=""
ERPNEXT_API_KEY=""
ERPNEXT_API_SECRET=""
ERPNEXT_COMPANY=""
ERPNEXT_WAREHOUSE=""
ERPNEXT_PRICE_LIST=""
ERPNEXT_SHIPPING_ITEM=""
# Optional ERPNext template; rates are configured there, never hardcoded.
ERPNEXT_SALES_TAX_TEMPLATE=""
# Required when recording actual COD receipts.
ERPNEXT_CASH_ACCOUNT=""
ERPNEXT_MODE_OF_PAYMENT=""
# Used only by the finance backend; never pass it to browser Supabase clients.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional protected scheduler GET /api/erpnext/sync (one order per invocation).
CRON_SECRET=""
